{%- from "partials/iconos.njk" import icono -%}
<footer class="pie">
  <div class="contenedor pie__rejilla">
    <div class="pie__marca">
      <a class="marca marca--clara" href="/" aria-label="{{ site.nombre }} — Inicio">{% include "partials/marca.njk" %}</a>
      <p class="pie__texto">{{ site.titulo_profesional }}. {{ site.ciudad }}.</p>
    </div>
    <nav class="pie__nav" aria-label="Secciones del sitio">
      <h2 class="pie__titulo">Secciones</h2>
      <ul>
        <li><a href="/">Inicio</a></li>
        {%- for item in navegacion %}<li><a href="{{ item.url }}">{{ item.texto }}</a></li>{% endfor %}
      </ul>
    </nav>
    <div class="pie__contacto">
      <h2 class="pie__titulo">Contacto</h2>
      <ul>
        {%- if site.correo %}<li><a href="mailto:{{ site.correo }}">{{ icono("correo") }} {{ site.correo }}</a></li>{% endif %}
        {%- if site.linkedin %}<li><a href="{{ site.linkedin }}" rel="noopener" target="_blank">{{ icono("linkedin") }} LinkedIn</a></li>{% endif %}
        {%- for p in site.otros_perfiles %}<li><a href="{{ p.url }}" rel="noopener" target="_blank">{{ icono("enlace") }} {{ p.nombre }}</a></li>{% endfor %}
        {%- if site.cv_publico %}<li><a href="{{ site.cv_publico }}" download>{{ icono("descarga") }} Currículum (PDF)</a></li>{% endif %}
      </ul>
    </div>
  </div>
  <div class="contenedor pie__legal">
    <p>© {{ entorno.anio }} {{ site.nombre }}. Los contenidos se publican a título personal y no representan la posición oficial de ninguna institución.</p>
  </div>
</footer>
