---
layout: layouts/base.njk
title: Juan Carlos Alvear Sepúlveda
clase_cuerpo: pagina-inicio
---
{%- from "partials/iconos.njk" import icono -%}
{%- from "partials/componentes.njk" import tarjetaPublicacion, filaRecurso -%}

<section class="portada">
  <div class="contenedor portada__rejilla">
    <div class="portada__texto">
      <p class="antetitulo antetitulo--claro">Gestión pública · Salud · Contratación pública</p>
      <h1 class="portada__nombre">Juan Carlos<br>Alvear Sepúlveda</h1>
      <p class="portada__titulo">{{ site.titulo_profesional }}</p>
      <p class="portada__mensaje">Más de 30 años de experiencia en el Servicio de Salud Ñuble, en dirección y asesoría en control interno, recursos físicos y financieros, abastecimiento, compras públicas y gestión de proyectos de inversión.</p>
      <div class="portada__acciones">
        <a class="boton boton--claro" href="/trayectoria/">Conocer mi trayectoria {{ icono("flecha") }}</a>
        {%- if site.cv_publico %}
        <a class="boton boton--contorno-claro" href="{{ site.cv_publico }}" download>{{ icono("descarga") }} Descargar currículum</a>
        {%- endif %}
      </div>
    </div>
    <div class="portada__retrato">
      {%- if site.foto %}
      <img class="retrato" src="{{ site.foto }}" alt="Fotografía de {{ site.nombre }}" width="420" height="520">
      {%- else %}
      <div class="retrato retrato--monograma" role="img" aria-label="Monograma {{ site.iniciales }}">
        <span>{{ site.iniciales }}</span>
      </div>
      {%- endif %}
    </div>
  </div>
</section>

<section class="cifras" aria-label="Experiencia en cifras">
  <div class="contenedor cifras__rejilla">
    <div class="cifra"><p class="cifra__valor">+30</p><p class="cifra__texto">años de servicio público en el Servicio de Salud Ñuble, desde 1993</p></div>
    <div class="cifra"><p class="cifra__valor">20</p><p class="cifra__texto">años a cargo del Abastecimiento en Red de la red asistencial <span style="white-space:nowrap">(2001–2022)</span></p></div>
    <div class="cifra"><p class="cifra__valor cifra__valor--texto">Nuevo Hospital Regional de Ñuble</p><p class="cifra__texto">Diseño e implementación del modelo de gestión del equipamiento, reconocido por el Minsal y replicado en otros Servicios de Salud</p></div>
    <div class="cifra"><p class="cifra__valor">5</p><p class="cifra__texto">diplomados de especialización en gestión pública y de salud (uno en desarrollo)</p></div>
  </div>
</section>

<section class="seccion">
  <div class="contenedor">
    <div class="seccion__encabezado">
      <div>
        <p class="antetitulo">Áreas de especialización</p>
        <h2 class="seccion__titulo">Conocimiento respaldado por la experiencia</h2>
      </div>
      <a class="enlace-flecha" href="/especializacion/">Ver todas las áreas {{ icono("flecha") }}</a>
    </div>
    <div class="rejilla rejilla--4">
      {%- for a in areas | limitar(8) %}
      <article class="area area--compacta revelar">
        <span class="area__icono">{{ icono(a.icono) }}</span>
        <h3 class="area__titulo">{{ a.titulo }}</h3>
      </article>
      {%- endfor %}
    </div>
  </div>
</section>

<section class="seccion seccion--gris">
  <div class="contenedor">
    <div class="seccion__encabezado">
      <div>
        <p class="antetitulo">Experiencias destacadas</p>
        <h2 class="seccion__titulo">Proyectos e iniciativas</h2>
      </div>
      <a class="enlace-flecha" href="/proyectos/">Ver todos los proyectos {{ icono("flecha") }}</a>
    </div>
    <div class="rejilla rejilla--2">
      {%- for p in collections.proyectos | destacados | limitar(2) %}
      <article class="destacado revelar">
        <p class="meta"><span class="etiqueta etiqueta--petroleo">{{ p.data.periodo }}</span></p>
        <h3 class="destacado__titulo"><a href="{{ p.url }}">{{ p.data.title }}</a></h3>
        <p class="destacado__texto">{{ p.data.resumen }}</p>
        {%- if p.data.cifras | length %}
        <ul class="destacado__cifras">{% for c in p.data.cifras %}<li>{{ c }}</li>{% endfor %}</ul>
        {%- endif %}
        <a class="enlace-flecha" href="{{ p.url }}">Ver proyecto {{ icono("flecha") }}</a>
      </article>
      {%- endfor %}
    </div>
  </div>
</section>

<section class="seccion">
  <div class="contenedor">
    <div class="seccion__encabezado">
      <div>
        <p class="antetitulo">Publicaciones</p>
        <h2 class="seccion__titulo">Últimos artículos</h2>
      </div>
      <a class="enlace-flecha" href="/publicaciones/">Ir a publicaciones {{ icono("flecha") }}</a>
    </div>
    {%- set ultimas = collections.publicaciones | limitar(3) %}
    {%- if ultimas | length %}
    <div class="rejilla rejilla--3">
      {%- for p in ultimas %}{{ tarjetaPublicacion(p) }}{% endfor %}
    </div>
    {%- else %}
    <p class="vacio">Próximamente se publicarán nuevos artículos.</p>
    {%- endif %}
  </div>
</section>

<section class="seccion seccion--gris">
  <div class="contenedor rejilla rejilla--2 rejilla--alinear">
    <div>
      <p class="antetitulo">Biblioteca digital</p>
      <h2 class="seccion__titulo">Documentos y recursos destacados</h2>
      <p class="seccion__bajada">Documentos técnicos, presentaciones, guías y material de capacitación para visualizar o descargar. En el Centro de conocimiento se reúne normativa y fuentes oficiales de consulta.</p>
      <div class="acciones">
        <a class="boton boton--primario" href="/biblioteca/">{{ icono("libro") }} Ir a la biblioteca</a>
        <a class="boton boton--secundario" href="/conocimiento/">Centro de conocimiento</a>
      </div>
    </div>
    <div class="lista-recursos">
      {%- set recursos = collections.biblioteca | destacados | limitar(3) %}
      {%- for r in recursos %}{{ filaRecurso(r) }}{% endfor %}
    </div>
  </div>
</section>

<section class="llamado">
  <div class="contenedor llamado__caja">
    <div>
      <h2 class="llamado__titulo">¿Desea ponerse en contacto?</h2>
      <p>Para consultas profesionales, invitaciones a actividades académicas o intercambio de experiencias.</p>
    </div>
    <a class="boton boton--claro" href="/contacto/">{{ icono("correo") }} Escribir un mensaje</a>
  </div>
</section>
